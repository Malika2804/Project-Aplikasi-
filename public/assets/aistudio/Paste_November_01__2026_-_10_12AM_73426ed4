  <script>
    // URL Google Apps Script yang terhubung ke Google Sheets Anda
    const GOOGLE_SHEET_WEB_APP_URL = "https://script.google.com/macros/s/AKfycbx.../exec"; // Masukkan URL Web App Google Sheets Anda di sini

    const FONT_PRESETS = [
      { id: 'small',  scale: 0.90, label: 'Ukuran Huruf: Kecil (90%)' },
      { id: 'normal', scale: 1.00, label: 'Ukuran Huruf: Normal (100%)' },
      { id: 'large',  scale: 1.15, label: 'Ukuran Huruf: Besar (115%)' },
      { id: 'xlarge', scale: 1.30, label: 'Ukuran Huruf: Sangat Besar (130%)' }
    ];

    let currentFontIndex = 1;

    function applyFontPreset(index) {
      if (index < 0 || index >= FONT_PRESETS.length) return;
      currentFontIndex = index;
      const preset = FONT_PRESETS[currentFontIndex];
      document.documentElement.style.setProperty('--font-scale', preset.scale);
      document.documentElement.setAttribute('data-font-preset', preset.id);
      document.getElementById('fontStatusLabel').innerText = preset.label;
    }

    function increaseFontSize() { if (currentFontIndex < FONT_PRESETS.length - 1) applyFontPreset(currentFontIndex + 1); }
    function decreaseFontSize() { if (currentFontIndex > 0) applyFontPreset(currentFontIndex - 1); }
    function resetFontSize() { applyFontPreset(1); }

    const VIDEO_STORAGE_KEY = 'siap_operasi_video_relaxation_v2';
    const DEFAULT_VIDEOS = { pain: "https://www.youtube.com/watch?v=TPIEEQtAUjg" };
    let videoUrls = { ...DEFAULT_VIDEOS };

    let currentSession = {
      id: Date.now(), fullName: '', age: '', gender: 'Perempuan', surgery: '', rmNumber: '',
      checklist: { procedure: false, prep: false, sideeffects: false, pain: false },
      apaisAnswers: [1, 1, 1, 1, 1, 1],
      anxietyScore: 4, infoScore: 2, specificConcerns: '', timestamp: new Date().toISOString()
    };

    let allSessions = [];
    try { allSessions = JSON.parse(localStorage.getItem('siap_operasi_sessions') || '[]'); } catch (e) { allSessions = []; }

    function switchTab(tabId) {
      ['profile', 'checklist', 'evaluation', 'infohub'].forEach(t => {
        document.getElementById(`tab-${t}`).classList.add('hidden');
        document.getElementById(`nav-${t}`).classList.remove('active');
      });
      document.getElementById(`tab-${tabId}`).classList.remove('hidden');
      document.getElementById(`nav-${tabId}`).classList.add('active');
      window.scrollTo(0, 0);
    }

    function setSurgery(val) { document.getElementById('inputSurgery').value = val; }

    function updateResetPatientButton() {
      const btn = document.getElementById('btnResetPatient');
      if (btn) btn.classList.toggle('hidden', !currentSession.fullName);
    }

    function saveProfileAndNext() {
      const name = document.getElementById('inputName').value.trim();
      if (!name) { alert('Mohon isi nama lengkap pasien.'); return; }
      currentSession.fullName = name;
      currentSession.age = document.getElementById('inputAge').value.trim();
      currentSession.gender = document.getElementById('inputGender').value;
      currentSession.surgery = document.getElementById('inputSurgery').value.trim();
      currentSession.rmNumber = document.getElementById('inputRM').value.trim();
      updateResetPatientButton();
      switchTab('checklist');
    }

    function startNewPatientSession() {
      if (!confirm('Mulai sesi pasien baru? Formulir akan dikosongkan.')) return;
      currentSession = {
        id: Date.now(), fullName: '', age: '', gender: 'Perempuan', surgery: '', rmNumber: '',
        checklist: { procedure: false, prep: false, sideeffects: false, pain: false },
        apaisAnswers: [1, 1, 1, 1, 1, 1], anxietyScore: 4, infoScore: 2,
        specificConcerns: '', timestamp: new Date().toISOString()
      };
      document.getElementById('inputName').value = '';
      document.getElementById('inputAge').value = '';
      document.getElementById('inputSurgery').value = '';
      document.getElementById('inputRM').value = '';
      document.getElementById('inputConcerns').value = '';
      ['procedure', 'prep', 'sideeffects', 'pain'].forEach(k => {
        const cb = document.getElementById(`check-${k}`);
        if (cb) cb.checked = false;
      });
      updateProgress();
      calculateApais();
      updateResetPatientButton();
    }

    function toggleCheck(key) {
      currentSession.checklist[key] = document.getElementById(`check-${key}`).checked;
      updateProgress();
    }

    function updateProgress() {
      const keys = Object.keys(currentSession.checklist);
      const done = keys.filter(k => currentSession.checklist[k]).length;
      const pct = Math.round((done / keys.length) * 100);
      document.getElementById('progressText').innerText = `${done} dari ${keys.length} Domain Selesai`;
      document.getElementById('progressPercent').innerText = `${pct}%`;
    }

    function calculateApais() {
      let answers = [];
      let anxietyTotal = 0;
      let infoTotal = 0;

      for (let i = 1; i <= 6; i++) {
        const radios = document.getElementsByName(`apais${i}`);
        let val = 1;
        for (const r of radios) {
          if (r.checked) { val = parseInt(r.value, 10); break; }
        }
        answers.push(val);
        if (i === 1 || i === 2 || i === 4 || i === 5) anxietyTotal += val;
        if (i === 3 || i === 6) infoTotal += val;
      }

      currentSession.apaisAnswers = answers;
      currentSession.anxietyScore = anxietyTotal;
      currentSession.infoScore = infoTotal;

      document.getElementById('apaisAnxietyScore').innerText = anxietyTotal;
      document.getElementById('apaisInfoScore').innerText = infoTotal;
    }

    // FUNGSI UTAMA: Simpan & Otomatis Kirim ke Google Sheets Anda di Latar Belakang
    function saveToGoogleSheetsOnly() {
      calculateApais();
      currentSession.fullName = document.getElementById('inputName').value.trim() || 'Pasien Pra-Bedah';
      currentSession.age = document.getElementById('inputAge').value.trim() || '-';
      currentSession.gender = document.getElementById('inputGender').value || '-';
      currentSession.surgery = document.getElementById('inputSurgery').value.trim() || '-';
      currentSession.rmNumber = document.getElementById('inputRM').value.trim() || '-';
      currentSession.specificConcerns = document.getElementById('inputConcerns').value.trim() || '-';
      currentSession.timestamp = new Date().toLocaleString('id-ID');

      const alertBox = document.getElementById('statusAlert');
      alertBox.className = 'status-alert loading';
      alertBox.innerText = 'Mengirim data ke Google Sheets...';
      alertBox.style.display = 'block';

      // 1. Simpan ke LocalStorage HP
      allSessions.push({ ...currentSession });
      try { localStorage.setItem('siap_operasi_sessions', JSON.stringify(allSessions)); } catch (e) {}

      // 2. Kirim Otomatis ke Google Sheets via Fetch
      if (GOOGLE_SHEET_WEB_APP_URL && GOOGLE_SHEET_WEB_APP_URL.indexOf("script.google.com") !== -1) {
        fetch(GOOGLE_SHEET_WEB_APP_URL, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(currentSession)
        })
        .then(() => {
          alertBox.className = 'status-alert success';
          alertBox.innerText = '✅ Data berhasil tersimpan & terkirim ke Google Sheets!';
          setTimeout(() => switchTab('infohub'), 1200);
        })
        .catch(err => {
          console.log("Error Sheets:", err);
          alertBox.className = 'status-alert success';
          alertBox.innerText = '✅ Data tersimpan di perangkat.';
          setTimeout(() => switchTab('infohub'), 1200);
        });
      } else {
        alertBox.className = 'status-alert success';
        alertBox.innerText = '✅ Data berhasil tersimpan.';
        setTimeout(() => switchTab('infohub'), 1200);
      }
    }

    const STAFF_ACCESS_PASSWORD = '280428';
    let pendingProtectedTarget = null;

    function requestProtectedAccess(target) {
      pendingProtectedTarget = target;
      const input = document.getElementById('staffPasswordInput');
      input.value = '';
      document.getElementById('passwordModal').classList.add('show');
    }

    function closePasswordModal() { document.getElementById('passwordModal').classList.remove('show'); }

    function submitStaffPassword() {
      const entered = document.getElementById('staffPasswordInput').value.trim();
      if (entered !== STAFF_ACCESS_PASSWORD) {
        document.getElementById('staffPasswordError').classList.remove('hidden');
        return;
      }
      const target = pendingProtectedTarget;
      closePasswordModal();
      if (target === 'video') document.getElementById('videoSettingsModal').classList.add('show');
      else if (target === 'qr_url') document.getElementById('qrUrlSettingsModal').classList.add('show');
      else if (target === 'research') { renderRecords(); document.getElementById('researchModal').classList.add('show'); }
    }

    function hideStaffPasswordError() { document.getElementById('staffPasswordError').classList.add('hidden'); }
    function openVideoSettings() { requestProtectedAccess('video'); }
    function closeVideoSettings() { document.getElementById('videoSettingsModal').classList.remove('show'); }
    function openResearchModal() { requestProtectedAccess('research'); }
    function closeResearchModal() { document.getElementById('researchModal').classList.remove('show'); }
    function openQrUrlSettings() { closeQrModal(); requestProtectedAccess('qr_url'); }
    function closeQrUrlSettings() { document.getElementById('qrUrlSettingsModal').classList.remove('show'); openQrModal(); }

    function renderRecords() {
      const countEl = document.getElementById('recordCount');
      const listEl = document.getElementById('recordsList');
      countEl.innerText = allSessions.length;
      if (allSessions.length === 0) {
        listEl.innerHTML = '<div class="section-subtitle" style="text-align: center; padding: 20px;">Belum ada data pasien tersimpan.</div>';
        return;
      }
      listEl.innerHTML = allSessions.map(s => `
        <div class="record-item" style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
          <div>
            <div style="font-weight: 700;">${s.fullName} (${s.age || '-'} th)</div>
            <div style="color: var(--slate-600); font-size: 11px;">Kecemasan: ${s.anxietyScore} | Info: ${s.infoScore}</div>
          </div>
        </div>
      `).join('');
    }

    function exportCSV() {
      if (allSessions.length === 0) { alert('Belum ada data.'); return; }
      const headers = ['ID', 'Nama', 'Usia', 'Gender', 'Operasi', 'RM', 'Kecemasan', 'Info', 'Waktu'];
      const rows = allSessions.map(s => [s.id, `"${s.fullName}"`, s.age, s.gender, `"${s.surgery}"`, s.rmNumber, s.anxietyScore, s.infoScore, `"${s.timestamp}"`]);
      const csv = [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
      const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = 'Rekap_APAIS.csv';
      link.click();
    }

    // QR Code Generator & Netlify Integration Link
    const QR_URL_STORAGE_KEY = 'siap_operasi_qr_net_url_v1';
    function getActiveQrWebUrl() {
      try {
        const saved = localStorage.getItem(QR_URL_STORAGE_KEY);
        if (saved && saved.trim()) return saved.trim();
      } catch (e) {}
      return "https://resplendent-zuccutto-9a64ae.netlify.app";
    }

    function openQrModal() {
      const url = getActiveQrWebUrl();
      document.getElementById('qrActiveUrlText').innerText = url;
      const canvas = document.getElementById('qrCanvas');
      // Simple canvas placeholder or generator if needed
      document.getElementById('qrAccessModal').classList.add('show');
    }
    function closeQrModal() { document.getElementById('qrAccessModal').classList.remove('show'); }
    function copyQrUrl() { navigator.clipboard.writeText(getActiveQrWebUrl()); alert('Tautan disalin!'); }
    function openQrTargetInBrowser() { window.open(getActiveQrWebUrl(), '_blank'); }
    function downloadQrPosterPng() { alert('Gunakan tangkapan layar atau generator QR standar untuk poster.'); }

    function saveCustomQrWebUrl() {
      const val = document.getElementById('customQrWebUrlInput').value.trim();
      if (val) {
        try { localStorage.setItem(QR_URL_STORAGE_KEY, val); } catch (e) {}
        alert('Link Netlify QR berhasil disimpan!');
      }
      document.getElementById('qrUrlSettingsModal').classList.remove('show');
      openQrModal();
    }
    function resetQrWebUrl() {
      try { localStorage.removeItem(QR_URL_STORAGE_KEY); } catch (e) {}
      alert('Link QR dikembalikan ke default Netlify.');
    }
  </script>
</body>
</html>